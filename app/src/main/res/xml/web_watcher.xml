<?xml version="1.0" encoding="utf-8"?>
<!-- Events from these browsers only, and nothing else on the phone. The same
     list as WebWatcher.BROWSERS. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:notificationTimeout="500"
    android:description="@string/web_watcher_description"
    android:packageNames="com.android.chrome,com.chrome.beta,com.chrome.dev,com.brave.browser,com.microsoft.emmx,com.vivaldi.browser,org.mozilla.firefox,com.sec.android.app.sbrowser,com.duckduckgo.mobile.android" />
